{
    "name": "regal-hardware",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Regal Hardware shop system - Regal till on Node.js + PostgreSQL",
    "scripts": {
        "db:setup": "npm run db:setup --prefix backend",
        "start": "npm start --prefix backend",
        "check": "node backend/tools/check-app.mjs",
        "test:e2e": "node backend/tools/run-e2e.mjs",
        "db:local": "npm run db:local --prefix backend",
        "install:all": "npm install --prefix backend && npm install --prefix backend/tools",
        "shot": "node backend/tools/shot.mjs",
        "test:e2e:raw": "node backend/tools/e2e.mjs",
        "import:sepos": "node backend/db/import-sepos.js",
        "reset:admin": "npm run reset:admin --prefix backend",
        "dev:backend": "npm run dev --prefix backend"
    },
    "dependencies": {
        "@neon/config": "^1.7.2",
        "@neon/env": "^1.4.3",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "jsonwebtoken": "^9.0.2",
        "mysql2": "^3.24.4",
        "nodemailer": "^10.0.10",
        "pg": "^8.12.0"
    },
    "engines": {
        "node": ">=18"
    }
}
