{
    "name":  "sepos-web",
    "version":  "1.0.0",
    "private":  true,
    "description":  "SePOS Web - React + Node.js + PostgreSQL point-of-sale system",
    "scripts":  {
                    "db:setup":  "npm run db:setup --prefix server",
                    "dev:server":  "npm run dev --prefix server",
                    "dev:client":  "npm run dev --prefix client",
                    "build":  "npm run build --prefix client",
                    "start":  "npm start --prefix server",
                    "check":  "node tools/check-app.mjs",
                    "test:e2e":  "node tools/e2e.mjs",
                    "db:local":  "npm run db:local --prefix server",
                    "install:all":  "npm install --prefix server \u0026\u0026 npm install --prefix tools",
                    "shot":  "node tools/shot.mjs"
                }
}
