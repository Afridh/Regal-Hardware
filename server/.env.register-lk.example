# Settings for the server on register.lk (cPanel). Copy this file to server/.env on the hosting and fill it in.
# server/.env is never put in git: it holds the database password and the signing secret.

NODE_ENV=production

# The MySQL database made in cPanel → MySQL Databases. cPanel puts your account name in front of both
# names (e.g. regalhw_regal and regalhw_app). If the password has @ : / ? # or %, write it URL-encoded
# (@ → %40, : → %3A, / → %2F, ? → %3F, # → %23, % → %25).
DATABASE_URL=mysql://CPANELUSER_app:PASSWORD@localhost:3306/CPANELUSER_regal

# The key every sign-in is signed with. Use the SAME value as on Vercel (Project → Settings → Environment
# Variables → JWT_SECRET), so tills and phones that are signed in now stay signed in after the move.
JWT_SECRET=

# How long a till's sign-in lasts (the /shift clock's own sign-in lasts 30 days)
JWT_EXPIRES=12h

# The site's own address, used in links the server writes (day-sheet reports)
PUBLIC_URL=https://www.regalhw.lk

# Copy these from Vercel as they are, if they are set there (leave empty if not)
SEED_ADMIN_PASSWORD=
SHIFT_DEVICE_KEY=
PRINT_DEVICE_KEY=
WA_VERIFY_TOKEN=
SHOP_TZ=
