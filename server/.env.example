PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sepos
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h
SEED_ADMIN_PASSWORD=admin123
CORS_ORIGIN=http://localhost:5173
# the fingerprint machine's own key — it may post punches and nothing else (docs/attendance.md)
SHIFT_DEVICE_KEY=
SHIFT_PHOTO_DAYS=120
# the print helper on the PC the printers are plugged into: the same key goes in
# tools/print-agent/config.json, and a bill made anywhere then prints on those printers
PRINT_DEVICE_KEY=

# AI support (Settings -> AI support in the till shows how to get this).
# The key is read here and never sent to the browser. Set a spend cap on the Anthropic
# account as well - that is the only hard limit on what this can cost.
ANTHROPIC_API_KEY=
# claude-sonnet-5 is the default: best at reasoning over figures.
# claude-haiku-4-5-20251001 is much cheaper and fine for writing posts.
ANTHROPIC_MODEL=
