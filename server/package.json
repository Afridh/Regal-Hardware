{
    "name":  "sepos-server",
    "version":  "1.0.0",
    "description":  "SePOS Web - Node.js / Express / PostgreSQL API",
    "type":  "module",
    "main":  "src/index.js",
    "scripts":  {
                    "dev":  "node --watch src/index.js",
                    "start":  "node src/index.js",
                    "db:schema":  "node db/migrate.js",
                    "db:seed":  "node db/seed.js",
                    "db:setup":  "npm run db:schema \u0026\u0026 npm run db:seed",
                    "db:local":  "node db/local-pg.js",
                    "db:clear-books":  "node db/clear-books.js",
                    "db:utf8":  "node db/recreate-utf8.js"
                },
    "dependencies":  {
                         "bcryptjs":  "^2.4.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.5",
                         "express":  "^4.19.2",
                         "jsonwebtoken":  "^9.0.2",
                         "pg":  "^8.12.0"
                     },
    "engines":  {
                    "node":  "\u003e=18"
                },
    "devDependencies":  {
                            "embedded-postgres":  "^18.4.0-beta.17"
                        },
    "allowScripts":  {
                         "@embedded-postgres/windows-x64@18.4.0-beta.17":  true
                     }
}
