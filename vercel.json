{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "app",
  "functions": { "api/index.js": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/", "destination": "/shop.html" },
    { "source": "/pos", "destination": "/index.html" },
    { "source": "/supplier", "destination": "/supplier.html" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/shift-api.php", "destination": "/api" },
    { "source": "/reports/:path*", "destination": "/api" }
  ]
}
