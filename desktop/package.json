{
  "name": "regal-pos",
  "productName": "Regal POS",
  "version": "1.1.1",
  "description": "Regal Hardware till for Windows - works with and without the internet",
  "author": "Regal Hardware",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "lk.regalhw.pos",
    "productName": "Regal POS",
    "files": [
      "main.js",
      "printing.js",
      "printers.html",
      "printers-preload.js",
      "icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Regal POS",
      "artifactName": "Regal-POS-Setup-${version}.exe"
    },
    "extraResources": [
      {
        "from": "../backend/tools/print-agent/print-image.ps1",
        "to": "print-image.ps1"
      },
      {
        "from": "../backend/tools/print-agent/print-raw.ps1",
        "to": "print-raw.ps1"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Afridh",
        "repo": "Regal-Hardware",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
